# ==========================================
# Configurações Gerais da Aplicação
# ==========================================
PORT=8080
ENV=development

# ==========================================
# Banco de Dados (GORM)
# ==========================================
# Opções para DB_DRIVER: "sqlite" ou "postgres"
DB_DRIVER=sqlite
DB_PATH=goscrapper.db

# Configurações do PostgreSQL (usado se DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=goscrapper_db
DB_SSLMODE=disable

# ==========================================
# Playwright
# ==========================================
# false = Abre a janela do navegador visualmente (ideal para dev)
# true  = Roda em background sem interface gráfica (ideal para Docker e produção)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_SEC=30

# ==========================================
# Redis (Opcional)
# Defina ENABLE_REDIS=true para torná-lo obrigatório na inicialização
# ==========================================
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# RabbitMQ (Opcional)
# Defina ENABLE_RABBITMQ=true para torná-lo obrigatório na inicialização
# ==========================================
ENABLE_RABBITMQ=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=scrape_tasks

# ==========================================
# RustFS / S3 Object Storage (Opcional)
# Defina ENABLE_RUSTFS=true para torná-lo obrigatório na inicialização
# Se false, utiliza o diretório local storage/screenshots/
# ==========================================
ENABLE_RUSTFS=false
RUSTFS_ENDPOINT=localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=goscrapper-screenshots
RUSTFS_USE_SSL=false
RUSTFS_PUBLIC_URL=http://localhost:9000
